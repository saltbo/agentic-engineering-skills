{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders API",
    "version": "0.1.0",
    "description": "Reviewable new contract for create, get and status-filtered list. The example HTTPS origin is a deployment placeholder. No API version selector is currently needed. Amount is integer cents in one fixed tenant-configured currency. Resource relationships beyond self are not exposed because no tenant API is defined."
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "Placeholder; replace with the real HTTPS origin before deployment."
    }
  ],
  "tags": [
    {
      "name": "Orders",
      "description": "Order identity, ownership, amounts and lifecycle."
    }
  ],
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "tags": [
          "Orders"
        ],
        "summary": "Create an order",
        "description": "Authorize creation in the trusted tenant. Assign immutable globally unique id and tenantId and initial pending status. Require a deduplication key because duplicate orders are costly. Key scope: validated issuer + subject + tenant + POST + canonical /orders. Retain successful outcomes for 24 hours from completion. Fingerprint is the validated normalized JSON body (key ordering and insignificant whitespace ignored). Atomically persist the order and successful deduplication result. Same key and body during retention replays original 201 body, Location, and ETag with a fresh Request-Id; original body can have an older status than current GET. Different body returns 422 with pointer #/headers/Idempotency-Key; in-flight duplicate returns 409. Authorization is checked on every replay. Failed validation does not reserve a key. Unknown outcomes may be retried with the same key within 24 hours; after expiry a retry can create a duplicate. This is bounded deduplication, not exactly-once execution.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "Order created.",
            "headers": {
              "Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord_001",
                  "tenantId": "tenant_01",
                  "status": "pending",
                  "totalCents": 1299,
                  "links": {
                    "self": "https://api.example.com/orders/ord_001"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              },
              "example": {
                "totalCents": 1299
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listOrders",
        "tags": [
          "Orders"
        ],
        "summary": "List orders",
        "description": "Only orders authorized for the principal in the trusted tenant are eligible. Apply authorization and status filter before counting and pagination. Order by id ascending using bytewise ASCII comparison; id is globally unique and is the deterministic tie-breaker. Calculate items and exact totalItems from the same read snapshot per request. totalPages = ceil(totalItems / pageSize), or 0 when empty. Each request sees fresh state; no cross-request snapshot guarantee, so concurrent inserts or status changes can shift numbered pages. Unknown, duplicate, or invalid query parameters return 400. GET can be retried safely.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Status"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "headers": {
              "Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Link": {
                "$ref": "#/components/headers/Link"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCollection"
                },
                "example": {
                  "items": [
                    {
                      "id": "ord_001",
                      "tenantId": "tenant_01",
                      "status": "pending",
                      "totalCents": 1299,
                      "links": {
                        "self": "https://api.example.com/orders/ord_001"
                      }
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "pageSize": 50,
                    "totalItems": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "tags": [
          "Orders"
        ],
        "summary": "Get an order",
        "description": "Authorize get permission and verify the order belongs to the principal trusted tenant. Cross-tenant and absent orders both return 404. GET can be retried safely.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read.",
            "headers": {
              "Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord_001",
                  "tenantId": "tenant_01",
                  "status": "pending",
                  "totalCents": 1299,
                  "links": {
                    "self": "https://api.example.com/orders/ord_001"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "shipped"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "totalCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Nonnegative integer cents in the tenant-configured currency. The tenant uses one fixed currency; conversion and client-selected currencies are unsupported."
          }
        },
        "required": [
          "totalCents"
        ],
        "additionalProperties": false,
        "example": {
          "totalCents": 1299
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "readOnly": true,
            "description": "Server-generated, globally unique, immutable opaque identifier."
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$",
            "readOnly": true,
            "description": "Immutable owner from the validated principal tenant context; never client-supplied."
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus",
            "readOnly": true,
            "description": "Created pending. Authoritative fulfillment may move pending to shipped; shipped is terminal. This API exposes no transition operation."
          },
          "totalCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "links": {
            "type": "object",
            "properties": {
              "self": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            },
            "required": [
              "self"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tenantId",
          "status",
          "totalCents",
          "links"
        ],
        "additionalProperties": false,
        "example": {
          "id": "ord_001",
          "tenantId": "tenant_01",
          "status": "pending",
          "totalCents": 1299,
          "links": {
            "self": "https://api.example.com/orders/ord_001"
          }
        }
      },
      "PagePagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "additionalProperties": false
      },
      "OrderCollection": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PagePagination"
          }
        },
        "required": [
          "items",
          "pagination"
        ],
        "additionalProperties": false,
        "example": {
          "items": [
            {
              "id": "ord_001",
              "tenantId": "tenant_01",
              "status": "pending",
              "totalCents": 1299,
              "links": {
                "self": "https://api.example.com/orders/ord_001"
              }
            }
          ],
          "pagination": {
            "page": 1,
            "pageSize": 50,
            "totalItems": 1,
            "totalPages": 1
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string",
                  "pattern": "^#/(body|query|path|headers)(/.*)?$",
                  "description": "JSON Pointer fragment into logical request body, query, path, or headers."
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "detail"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1
        },
        "description": "One-based page. Beyond the last page returns 200 and empty items, retaining requested page."
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "description": "Maximum orders on the requested page."
      },
      "Status": {
        "name": "status",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/OrderStatus"
        },
        "description": "Exact equality filter on order status. Omission includes both states."
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": "Globally unique opaque order ID."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "pattern": "^\"[A-Za-z0-9_-]{1,128}\"$"
        },
        "description": "Project deduplication header, an RFC 8941 quoted string. Reuse the same value for retries of one creation."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Required on every response. A fresh server-generated opaque request identifier, including on idempotent replays.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "CacheControl": {
        "required": true,
        "description": "Private order data is never cached.",
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      },
      "Location": {
        "required": true,
        "description": "Absolute canonical URL of the created order.",
        "schema": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "ETag": {
        "required": true,
        "description": "Strong validator of the returned order representation; changes when status changes.",
        "schema": {
          "type": "string",
          "pattern": "^\"[^\"\\r\\n]+\"$"
        },
        "example": "\"order-001-r1\""
      },
      "Link": {
        "description": "Absolute RFC 8288 navigation URLs. Preserve status and pageSize. For nonempty results include first and last, previous if page > 1 (capped to last page), next if page < totalPages. Omit Link when totalItems = 0. No links in the collection body.",
        "schema": {
          "type": "string"
        },
        "example": "<https://api.example.com/orders?page=1&pageSize=50>; rel=\"first\", <https://api.example.com/orders?page=1&pageSize=50>; rel=\"last\""
      },
      "WWWAuthenticate": {
        "required": true,
        "description": "Bearer challenge; invalid credentials add error=\"invalid_token\".",
        "schema": {
          "type": "string"
        },
        "example": "Bearer realm=\"orders\""
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON, invalid query/path syntax, unknown query parameters, or missing/malformed Idempotency-Key.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Bad Request",
              "status": 400,
              "detail": "Malformed JSON, invalid query/path syntax, unknown query parameters, or missing/malformed Idempotency-Key.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer credential.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWWAuthenticate"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Unauthorized",
              "status": 401,
              "detail": "Missing or invalid bearer credential.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated principal lacks the requested collection or operation permission, or lacks one trusted tenant context.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Forbidden",
              "status": 403,
              "detail": "Authenticated principal lacks the requested collection or operation permission, or lacks one trusted tenant context.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "NotFound": {
        "description": "Order is absent or belongs to another tenant; return identical concealed response.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Not Found",
              "status": 404,
              "detail": "Order is absent or belongs to another tenant; return identical concealed response.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "Accept excludes supported response representations.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Not Acceptable",
              "status": 406,
              "detail": "Accept excludes supported response representations.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "Conflict": {
        "description": "Same idempotency key is still processing. Retry with the same key and body after completion.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Conflict",
              "status": 409,
              "detail": "Same idempotency key is still processing. Retry with the same key and body after completion.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Creation requires application/json.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Unsupported Media Type",
              "status": 415,
              "detail": "Creation requires application/json.",
              "instance": "urn:request:req_001"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Valid JSON violates the create schema, or the same idempotency key is reused with a different normalized body.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://api.example.com/problems/validation-error",
              "title": "Request validation failed",
              "status": 422,
              "detail": "Valid JSON violates the create schema, or the same idempotency key is reused with a different normalized body.",
              "instance": "urn:request:req_001",
              "errors": [
                {
                  "pointer": "#/body/totalCents",
                  "detail": "must be a nonnegative integer"
                }
              ]
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server failure; no implementation details or secrets are exposed.",
        "headers": {
          "Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Internal Server Error",
              "status": 500,
              "detail": "Unexpected server failure; no implementation details or secrets are exposed.",
              "instance": "urn:request:req_001"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use an existing trusted bearer issuer. Validate issuer, audience, signature/proof, expiry and revocation before deriving subject and exactly one tenant context. Credentials do not by themselves authorize an operation. Enforce operation permission and authoritative tenant ownership separately. Issuer deployment configuration is outside this design."
      }
    }
  }
}
